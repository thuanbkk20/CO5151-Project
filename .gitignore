eval/results/

# environment files
.env

# Chainlit (frontend): generated translations and uploaded files; /.chainlit/ appears when Chainlit runs from
# the repo root (the app's own config is frontend/.chainlit/config.toml)
frontend/.chainlit/translations/*
!frontend/.chainlit/translations/vi-VN.json
frontend/.files/
/.chainlit/
/.files/

# Local data of the apps (chat history database)
.data/

# Personal Claude Code settings and agents
.claude/settings.local.json
.claude/agents/researcher.md
.claude/.memory/

# Terraform (infra/): provider downloads, state (holds resource details), local variable values
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
