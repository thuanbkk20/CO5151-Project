# Copy thành .env ở thư mục gốc repo rồi điền giá trị:  cp .env.example .env
# Mọi lệnh (co5151-api, co5151-web, student-mcp, regulation-mcp, co5151-eval) tự đọc file này. Biến đã set trong
# shell được ưu tiên. Không commit .env.

# Student Record MCP
# Secret ký token Student Record; backend dùng chung secret này để cấp token cho người đăng nhập
STUDENT_MCP_TOKEN_SECRET=change-me-to-a-long-random-string
# Hạn (giây) của token Student Record; backend cấp token mới cho mỗi câu hỏi nên để ngắn
STUDENT_MCP_TOKEN_TTL=300
STUDENT_MCP_HOST=127.0.0.1
STUDENT_MCP_PORT=8102
STUDENT_MCP_LOG_LEVEL=INFO
# STUDENT_MCP_DB_PATH=:memory:

# Regulation MCP (Streamable HTTP tại http://REGULATION_MCP_HOST:REGULATION_MCP_PORT/mcp)
# Dữ liệu hiện là bản nháp, chưa được phê duyệt; false thì mọi tra cứu bị từ chối
REGULATION_ALLOW_DRAFT=true
REGULATION_MCP_HOST=127.0.0.1
REGULATION_MCP_PORT=8103
REGULATION_MCP_LOG_LEVEL=INFO

# Backend API (co5151-api)
# Secret ký access token của API, chuỗi ngẫu nhiên dài
BACKEND_TOKEN_SECRET=change-me-to-a-long-random-string
# Hạn (giây) của access token; nên bằng user_session_timeout trong frontend/.chainlit/config.toml (1 ngày)
BACKEND_TOKEN_TTL=86400
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8100
BACKEND_LOG_LEVEL=INFO
# Lịch sử chat và trace mỗi câu trả lời. URL SQLAlchemy async: để trống = file SQLite backend/.data/chat.db;
# off = chỉ giữ trong bộ nhớ đến khi tắt backend; server: postgresql+asyncpg://user:pass@host:5432/co5151
CHAT_DATABASE_URL=
# Địa chỉ hai MCP server; để trống = http://<..._HOST>:<..._PORT>/mcp
STUDENT_MCP_URL=
REGULATION_MCP_URL=
# File tài khoản demo (thay SSO); để trống = accounts.json của student-server
DEMO_ACCOUNTS_FILE=
# Số tin nhắn gần nhất của hội thoại đưa vào prompt khi soạn câu trả lời
ADVISOR_HISTORY_MESSAGES=10

# LLM qua endpoint OpenAI-compatible
# Provider mặc định: gemini | openai | kimi (base URL và model mặc định khai báo trong backend infrastructure/llm.py)
LLM_PROVIDER=gemini
# Key của từng provider; chỉ provider có key mới hiện trong giao diện
GEMINI_API_KEY=
OPENAI_API_KEY=
# Kimi qua opencode.ai
OPENCODE_API_KEY=
# Tùy chọn, đè lên mặc định của LLM_PROVIDER; để trống thì dùng mặc định
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Mức thinking, ví dụ low | medium; để trống thì không gửi (mặc định gemini-3.5-flash-lite chạy không thinking)
LLM_REASONING_EFFORT=
# Số giây chờ mỗi lời gọi LLM trước khi báo lỗi
LLM_TIMEOUT=60
# Planner chọn bước tiếp theo bằng luật trước; khi luật không quyết được thì hỏi: llm (1 lời gọi ngắn) | laya | rule
# (không hỏi, dùng bước mặc định)
ADVISOR_PLANNER_MODE=llm
# Chỉ dùng khi ADVISOR_PLANNER_MODE=laya
# LAYA_SERVER_URL=http://127.0.0.1:8000/v1/systemone
# Verifier kiểm bản nháp trước khi trả lời. llm: kiểm bằng luật rồi gọi LLM thêm 1 lần cho mỗi câu trả lời;
# rules: chỉ kiểm bằng luật, không tốn thêm lần gọi LLM; off: tắt (agent đơn)
ADVISOR_VERIFIER=llm
# Model riêng cho Verifier (cùng provider với câu trả lời); để trống thì dùng chung model
VERIFIER_LLM_MODEL=

# Giao diện chat (co5151-web)
# Secret ký phiên đăng nhập của Chainlit, chuỗi ngẫu nhiên dài. Tạo bằng: uv run chainlit create-secret
CHAINLIT_AUTH_SECRET=change-me-to-a-long-random-string
CHAINLIT_PORT=8000
# Địa chỉ backend API
BACKEND_URL=http://127.0.0.1:8100
