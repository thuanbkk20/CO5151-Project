# Copy thành .env ở thư mục gốc repo rồi điền giá trị:  cp .env.example .env
# Mọi lệnh (student-mcp, co5151-eval, ...) tự đọc file này. Biến đã set trong shell được ưu tiên.
# Không commit .env.

# Student Record MCP
STUDENT_MCP_TOKEN_SECRET=change-me-to-a-long-random-string
STUDENT_MCP_TOKEN_TTL=3600
STUDENT_MCP_HOST=127.0.0.1
STUDENT_MCP_PORT=8102
STUDENT_MCP_LOG_LEVEL=INFO
# STUDENT_MCP_DB_PATH=:memory:

# Advisor: LLM qua endpoint OpenAI-compatible
# Provider đang dùng: gemini | openai | kimi (base URL và model mặc định khai báo trong co5151_advisor/llm.py)
LLM_PROVIDER=gemini
# Key của từng provider; chỉ cần điền key của provider đang chọn
GEMINI_API_KEY=
OPENAI_API_KEY=
# Kimi qua opencode.ai
OPENCODE_API_KEY=
# Tùy chọn, đè lên mặc định của provider đang chọn; để trống thì dùng mặc định
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Mức thinking, ví dụ low | medium; để trống thì không gửi (mặc định gemini-3.5-flash-lite chạy không thinking)
LLM_REASONING_EFFORT=
# Số giây chờ mỗi lời gọi LLM trước khi báo lỗi
LLM_TIMEOUT=60
# llm, rule hoặc laya
ADVISOR_PLANNER_MODE=llm
# mcp: tra cứu Regulation MCP (dữ liệu quy chế thật); static: 4 điều viết tay, chỉ để test
ADVISOR_REGULATION_SOURCE=mcp

# Regulation MCP: dữ liệu hiện là bản nháp, chưa được phê duyệt; false thì mọi tra cứu bị từ chối
REGULATION_ALLOW_DRAFT=true
# LAYA_SERVER_URL=http://127.0.0.1:8000/v1/systemone
