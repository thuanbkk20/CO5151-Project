{
  "$defs": {
    "WarningRecord": {
      "additionalProperties": false,
      "properties": {
        "semester": {
          "pattern": "^([0-9]{4}[123]|BL)$",
          "title": "Semester",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "consecutive": {
          "title": "Consecutive",
          "type": "integer"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        }
      },
      "required": [
        "semester",
        "reason",
        "consecutive",
        "decision"
      ],
      "title": "WarningRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "student_id": {
      "pattern": "^[0-9]{7}$",
      "title": "Student Id",
      "type": "string"
    },
    "currently_warned": {
      "title": "Currently Warned",
      "type": "boolean"
    },
    "consecutive_warnings": {
      "title": "Consecutive Warnings",
      "type": "integer"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/WarningRecord"
      },
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "student_id",
    "currently_warned",
    "consecutive_warnings",
    "history"
  ],
  "title": "WarningHistory",
  "type": "object"
}
