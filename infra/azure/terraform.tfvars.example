# Copy thành terraform.tfvars (đã gitignore) rồi điền. Biến không ghi ở đây dùng giá trị mặc định trong
# variables.tf. Không ghi secret vào file này: Terraform lưu giá trị biến vào state ở dạng rõ.

# Bắt buộc. IP public hiện tại của máy bạn (xem bằng: curl -s https://api.ipify.org), thêm /32. IP nhà mạng đổi
# thì sửa lại và chạy terraform apply.
admin_cidr = "203.0.113.7/32"

