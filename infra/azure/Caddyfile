# Caddy trên VM: HTTPS tự động (Let's Encrypt) cho tên miền của IP public, basic auth trước toàn bộ trang, chuyển
# tiếp vào Chainlit (kể cả websocket). Giá trị {$...} lấy từ /etc/caddy/caddy.env do deploy.sh ghi.

{$APP_DOMAIN} {
	encode zstd gzip

	# Một tài khoản chung cho nhóm và thầy: người lạ không vào được trang, không dùng được key LLM.
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	reverse_proxy 127.0.0.1:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log
}
